{
  "name": "better-solitaire",
  "version": "1.0.0",
  "description": "Better Solitaire — free, no-ads, no-IAP Klondike. First in the \"Better\" series.",
  "license": "MIT",
  "author": "Elizabeth Hutton",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "solver:build": "node scripts/build-solvitaire.cjs",
    "deals:generate": "node scripts/generate-winnable-deals.cjs",
    "deals:verify": "node --test tests/winnable-deals.test.cjs",
    "sync": "cap sync",
    "ios": "cap sync ios && cap open ios",
    "assets": "capacitor-assets generate",
    "test:layout": "playwright test --config playwright.config.mjs",
    "snapshot:baseline": "node scripts/snapshot-baseline.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.62.0"
  }
}
