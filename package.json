{
  "name": "better-solitaire",
  "version": "1.0.0",
  "description": "Better Solitaire — free, no-ads, no-IAP Klondike. First in the \"Better\" series.",
  "license": "MIT",
  "author": "Elizabeth Hutton",
  "private": true,
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run lint && npm run format && npm test",
    "test": "node --test tests/*.test.cjs",
    "solver:build": "node scripts/build-solvitaire.cjs",
    "deals:generate": "node scripts/generate-winnable-deals.cjs",
    "deals:verify": "node --test tests/winnable-deals.test.cjs",
    "verify:hints": "node scripts/verify-hints.cjs",
    "sync": "cap sync",
    "ios": "cap sync ios && cap open ios",
    "assets": "capacitor-assets generate",
    "test:layout": "playwright test --config playwright.config.mjs",
    "test:layout:chromium": "playwright test --config playwright.config.mjs --project=chromium",
    "test:layout:webkit": "playwright test --config playwright.config.mjs --project=webkit",
    "snapshot:baseline": "node scripts/snapshot-baseline.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6"
  }
}
